{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "opener:default",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "http://10.8.0.*:3001/*" },
        { "url": "http://192.168.*:3001/*" },
        { "url": "http://localhost:3001/*" },
        { "url": "http://raspberry.lan:3001/*" }
      ]
    }
  ]
}